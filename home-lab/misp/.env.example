# MISP Configuration

# MySQL Database Settings
MISP_MYSQL_ROOT_PASSWORD=your_secure_root_password_here
MISP_MYSQL_PASSWORD=your_secure_misp_password_here

# MISP Admin Account
MISP_ADMIN_EMAIL=admin@yourdomain.com
MISP_ADMIN_PASS=your_secure_admin_password_here

# MISP Organization
MISP_ORG=HassanSecurityLab
MISP_ORG_UUID=a0b1c2d3-e4f5-6789-abcd-ef0123456789
MISP_EMAIL=admin@hassansecurity.lab

# MISP Base URL (adjust to your LAN IP)
MISP_BASEURL=http://192.168.3.71:8080

# Security (at least 32 chars each)
MISP_SECURITY_SALT=longrandomstringthatshouldbe32charsminimum

# Timezone
TIMEZONE=Africa/Nairobi
